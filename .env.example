# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TEXT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# AssemblyAI: voice notes in, text out. Free key at assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_SPEECH_MODEL=universal
ASSEMBLYAI_LANGUAGE_CODE=en
# Below this word confidence, a money word is queried instead of booked
ASSEMBLYAI_CONFIDENCE_FLOOR=0.6
ASSEMBLYAI_POLL_INTERVAL_MS=3000
ASSEMBLYAI_TIMEOUT_MS=180000

# Live grounding for market prices
TAVILY_API_KEY=

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
